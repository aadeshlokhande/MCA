# ==============================================================================
# AI-Based Drug Recommendation System - Environment Configuration Example
# Copy this file to '.env' and update variables for your target deployment.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration (Default is SQLite for local development; uncomment for PostgreSQL)
# DATABASE_URL=postgres://postgres:password@localhost:5432/drug_recommendation_db

# Security & Cookie Settings for Production (Set to True behind HTTPS reverse proxy)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
